# Copy this file to .env.migration.local. Never commit the local copy.
SOURCE_DATABASE_URL="postgresql://<render-user>:<url-encoded-password>@<render-host>:5432/<render-db>?sslmode=require"
TARGET_DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"
