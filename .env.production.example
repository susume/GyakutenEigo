NODE_ENV="production"
PORT=4000
JWT_SECRET="replace-with-a-long-random-production-secret"

# Temporary compatibility mode while DNS still points directly to GitHub Pages.
# Remove VITE_API_URL and set VITE_ALLOW_PRODUCTION_API_OVERRIDE="false" only
# after the Cloudflare /api/* and /socket.io/* routes are verified live.
VITE_API_URL="https://gyakuteneigo-api.onrender.com"
VITE_ALLOW_PRODUCTION_API_OVERRIDE="true"

# Use "/" for a custom domain, or "/your-repo-name/" for default GitHub Pages project hosting.
VITE_BASE_PATH="/"

# Comma-separated list of allowed hosted frontend origins.
CLIENT_ORIGIN="https://gyakuteneigo.com,https://www.gyakuteneigo.com,https://susume.github.io"

# Set to true when hosted behind a reverse proxy such as Render, Railway, Fly, or Nginx.
TRUST_PROXY="true"

# Required in production. The server start command applies committed migrations before listening.
DATABASE_URL="postgresql://user:password@host:5432/quizstrike?schema=public"

# Speaking Practice providers run only on the server. Google AI Studio's
# Gemini adapter accepts the browser's recorded audio for transcription.
# Do not expose the key through VITE_* variables.
SPEAKING_AI_PROVIDER="gemini"
SPEAKING_TRANSCRIPTION_PROVIDER="gemini"
SPEAKING_GEMINI_API_KEY="replace-with-a-server-only-key"
SPEAKING_GEMINI_MODEL="gemini-2.5-flash-lite"
SPEAKING_GEMINI_TRANSCRIPTION_MODEL="gemini-2.5-flash-lite"
# Optional hybrid mode: keep Gemini for conversation and use OpenAI's
# dedicated audio endpoint for usually faster transcription. Only use this
# when an OpenAI server-side key is available.
# SPEAKING_AI_PROVIDER="gemini"
# SPEAKING_TRANSCRIPTION_PROVIDER="openai"
# SPEAKING_OPENAI_API_KEY="replace-with-a-server-only-key"
# SPEAKING_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
# OpenAI is also supported as an alternative:
# SPEAKING_AI_PROVIDER="openai"
# SPEAKING_TRANSCRIPTION_PROVIDER="openai"
# SPEAKING_OPENAI_API_KEY="replace-with-a-server-only-key"
# SPEAKING_OPENAI_MODEL="gpt-4o-mini"
# SPEAKING_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
# Optional bounded provider waits. The per-operation values override the
# shared value; defaults are 15000/12000/12000/30000 ms.
# SPEAKING_PROVIDER_TIMEOUT_MS=""
# SPEAKING_TRANSCRIPTION_TIMEOUT_MS="15000"
# SPEAKING_CONVERSATION_TIMEOUT_MS="12000"
# SPEAKING_HELP_TIMEOUT_MS="12000"
# SPEAKING_EVALUATION_TIMEOUT_MS="30000"
# Enable only for a short diagnostic window. Logs contain timing and byte
# counts only, never transcript text, audio, identifiers, or secrets.
SPEAKING_LATENCY_DEBUG="false"
# Optional bounded classroom session lifetime in seconds (default: 28800 / 8 hours).
SPEAKING_SESSION_LIFETIME_SECONDS="28800"

# Optional short-term diagnostics. Leave false normally; true emits one
# aggregated application-payload report per interval, never per movement packet.
NETWORK_DEBUG="false"
NETWORK_REPORT_INTERVAL_MS="60000"
VITE_NETWORK_DEBUG="false"
