generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  teacher
  admin
}

enum SessionStatus {
  waiting
  active
  paused
  ended
}

enum Team {
  blue
  red
}

enum CompetitionType {
  SPONSORED
  SCHOOL_VS_SCHOOL
  CLAN_VS_CLASS
}

enum CompetitionStatus {
  DRAFT
  ANNOUNCED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  STUDY_PERIOD
  CHECK_IN
  LIVE
  COMPLETED
  CANCELLED
}

enum CompetitionVisibility {
  PUBLIC
  INVITATION_ONLY
}

enum CompetitionStreamingStatus {
  OFF
  APPROVAL_REQUIRED
  APPROVED
}

enum CompetitionRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompetitionEligibilityStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
}

enum CompetitionCheckInStatus {
  NOT_OPEN
  OPEN
  CHECKED_IN
  MISSED
}

enum CompetitionMatchStatus {
  SCHEDULED
  CHECK_IN
  LIVE
  CONFIRMED
  DISPUTED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(teacher)
  classes      Class[]
  quizSets     QuizSet[]
  folders      Folder[]
  sessions     GameSession[]
  reports      Report[]
  tournaments  Tournament[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Class {
  id          String        @id @default(cuid())
  teacherId   String
  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quizSets    QuizSet[]
  sessions    GameSession[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model QuizSet {
  id           String        @id @default(cuid())
  teacherId    String
  classId      String?
  folderId     String?
  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  folder       Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  /// Immutable-compatible authoring settings that are not relational columns.
  settingsJson Json          @default("{}")
  questions    Question[]
  sessions     GameSession[]
  reports      Report[]
  tournaments  Tournament[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([teacherId, folderId])
}

model Folder {
  id        String    @id @default(cuid())
  teacherId String
  parentId  String?
  teacher   User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Folder[]  @relation("FolderHierarchy")
  quizSets  QuizSet[]
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([teacherId, parentId])
}

model Question {
  id            String      @id @default(cuid())
  quizSetId     String
  quizSet       QuizSet     @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
  prompt        String
  choiceA       String
  choiceB       String
  choiceC       String
  choiceD       String
  correctChoice String
  explanation   String?
  difficulty    String?
  audioUrl      String?
  audioAsset    QuestionAudio?
  answerLogs    AnswerLog[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model QuestionAudio {
  questionId String   @id
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mimeType   String
  data       Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GameSession {
  id           String          @id @default(cuid())
  teacherId    String
  classId      String?
  quizSetId    String?
  teacher      User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  quizSet      QuizSet?        @relation(fields: [quizSetId], references: [id], onDelete: SetNull)
  /// Historical label captured when the session is created.
  quizSetName  String          @default("Quiz Set")
  sessionCode  String          @unique
  status       SessionStatus   @default(waiting)
  maxPlayers   Int             @default(20)
  currentRound Int             @default(1)
  settingsJson Json
  players      PlayerSession[]
  answerLogs   AnswerLog[]
  roundLogs    RoundLog[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  startedAt    DateTime?
  endedAt      DateTime?
  tournamentMatch TournamentMatch?

  @@index([teacherId, status])
}

model PlayerSession {
  id             String      @id @default(cuid())
  gameSessionId  String
  gameSession    GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  nickname       String
  team           Team
  money          Int         @default(0)
  isAlive        Boolean     @default(true)
  score          Int         @default(0)
  correctAnswers Int         @default(0)
  wrongAnswers   Int         @default(0)
  socketId       String?
  gear           String      @default("starter_blaster")
  joinedAt       DateTime    @default(now())
  leftAt         DateTime?
  answerLogs     AnswerLog[]

  @@unique([gameSessionId, nickname])
}

model AnswerLog {
  id              String        @id @default(cuid())
  gameSessionId   String
  playerSessionId String
  questionId      String?
  gameSession     GameSession   @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  playerSession   PlayerSession @relation(fields: [playerSessionId], references: [id], onDelete: Cascade)
  question        Question?     @relation(fields: [questionId], references: [id], onDelete: SetNull)
  /// Immutable question context retained if the authoring question changes.
  questionPrompt  String        @default("")
  correctChoice   String        @default("A")
  selectedChoice  String
  isCorrect       Boolean
  moneyAwarded    Int
  responseTimeMs  Int?
  answeredAt      DateTime      @default(now())
}

model RoundLog {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  roundNumber   Int
  winningTeam   Team?
  startedAt     DateTime    @default(now())
  endedAt       DateTime?
}

/// Normalized teacher-facing report metadata and an immutable report detail snapshot.
/// Keeping detailJson together makes report reads atomic while avoiding the runtime
/// snapshot's unbounded teacher-library JSON blob.
model Report {
  id          String   @id @default(cuid())
  teacherId   String
  sessionId   String
  sessionCode String
  quizSetId   String?
  quizSetName String
  displayName String
  detailJson  Json
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  quizSet     QuizSet? @relation(fields: [quizSetId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teacherId, sessionId])
  @@index([teacherId, createdAt, id])
}

/// Recoverable active-session checkpoint plus legacy migration source. Durable
/// teacher-library and historical data is authoritative in normalized models.
model RuntimeSnapshot {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Official QuizStrike competition configuration. Roster and result snapshots
/// remain available to the in-memory room authority while normalized records
/// provide durable organizer data and auditability.
model Competition {
  id                      String                      @id @default(cuid())
  slug                    String                      @unique
  name                    String
  description             String
  coverImage              String
  sponsorName             String?
  sponsorArtwork          String?
  type                    CompetitionType
  organizerId             String
  organizerName           String
  status                  CompetitionStatus           @default(DRAFT)
  registrationOpensAt     DateTime
  registrationClosesAt    DateTime
  rosterDeadline          DateTime
  studyPackReleaseAt      DateTime
  matchStartAt            DateTime
  matchEndAt              DateTime
  region                  String
  timeZone                String
  division                String
  difficulty              String
  activeTeamSize          Int
  substituteLimit         Int
  maximumTeams            Int
  matchFormat             String
  mapPoolJson             Json
  gameMode                String
  rulesVersion            String
  prizeDescription        String
  visibility              CompetitionVisibility      @default(PUBLIC)
  registrationRequirements Json
  streamingStatus         CompetitionStreamingStatus @default(OFF)
  rulesSummary            Json
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  studyPack               CompetitionStudyPack?
  announcements           CompetitionAnnouncement[]
  teams                   CompetitionTeam[]
  matches                 CompetitionMatch[]
  notifications           CompetitionNotification[]
  auditLogs               CompetitionAuditLog[]

  @@index([status, registrationOpensAt])
  @@index([type, division, region])
}

model CompetitionStudyPack {
  id                   String      @id @default(cuid())
  competitionId        String      @unique
  version              String
  releaseAt            DateTime
  releasedAt           DateTime?
  correctionVersion    Int         @default(0)
  wordsJson            Json
  correctionHistoryJson Json
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  competition          Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

model CompetitionAnnouncement {
  id             String      @id @default(cuid())
  competitionId  String
  title          String
  body           String
  publishedAt    DateTime
  publishedByName String
  pinned         Boolean     @default(false)
  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, publishedAt])
}

model CompetitionTeam {
  id                   String                         @id @default(cuid())
  competitionId        String
  teamName             String
  affiliation          String
  logoUrl              String?
  captainUserId        String
  captainName          String
  coachUserId          String?
  coachName            String?
  activePlayersJson    Json
  substitutePlayersJson Json
  registrationStatus   CompetitionRegistrationStatus @default(PENDING)
  eligibilityStatus    CompetitionEligibilityStatus @default(PENDING)
  checkInStatus        CompetitionCheckInStatus      @default(NOT_OPEN)
  seed                 Int?
  division             String
  invitationCode       String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  competition          Competition                    @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, registrationStatus, eligibilityStatus])
}

model CompetitionMatch {
  id              String                  @id @default(cuid())
  competitionId   String
  roundLabel      String
  bracketPosition Int
  homeTeamId      String?
  awayTeamId      String?
  scheduledAt     DateTime
  checkInOpensAt  DateTime
  map             String
  gameMode        String
  status          CompetitionMatchStatus  @default(SCHEDULED)
  sessionCode     String?
  refereeName     String?
  resultJson      Json?
  competition     Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, scheduledAt])
}

model CompetitionNotification {
  id             String      @id @default(cuid())
  key            String      @unique
  competitionId  String
  recipientUserId String?
  kind           String
  title          String
  body           String
  createdAt      DateTime    @default(now())
  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
}

model CompetitionAuditLog {
  id            String      @id @default(cuid())
  competitionId String
  actorUserId   String
  actorName     String
  action        String
  detail        String
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, createdAt])
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  STUDY_PACK_RELEASED
  CHECK_IN
  LIVE
  COMPLETED
  CANCELLED
}

enum TournamentLevel {
  SCHOOL_VS_SCHOOL
  CLASS_VS_CLASS
  IN_SCHOOL
  INVITATIONAL
  SPONSORED
}

enum TournamentTeamStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TournamentMatchStatus {
  SCHEDULED
  CHECK_IN
  LIVE
  COMPLETED
  BYE
  FORFEIT
  CANCELLED
}

model Tournament {
  id                    String           @id @default(cuid())
  slug                  String           @unique
  ownerId               String
  owner                 User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title                 String
  description           String           @default("")
  sponsorName           String?
  sponsorMessage        String?
  sponsorUrl            String?
  level                 TournamentLevel
  status                TournamentStatus @default(DRAFT)
  tournamentAt          DateTime
  registrationDeadline  DateTime
  timeZone              String           @default("Asia/Tokyo")
  maximumTeams          Int
  quizSetId             String?
  quizSet               QuizSet?         @relation(fields: [quizSetId], references: [id], onDelete: SetNull)
  quizSetName           String
  rulesJson             Json
  invitationCodesJson   Json             @default("[]")
  championTeamId        String?
  runnerUpTeamId        String?
  publishedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  studyPack             TournamentStudyPack?
  teams                 TournamentTeam[]
  matches               TournamentMatch[]
  auditEvents           TournamentAuditEvent[]

  @@index([ownerId, status])
  @@index([status, tournamentAt])
  @@index([registrationDeadline])
}

model TournamentStudyPack {
  id           String                 @id @default(cuid())
  tournamentId String                 @unique
  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  releaseAt    DateTime
  releasedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  items        TournamentStudyItem[]
}

model TournamentStudyItem {
  id          String               @id @default(cuid())
  studyPackId String
  studyPack   TournamentStudyPack @relation(fields: [studyPackId], references: [id], onDelete: Cascade)
  term        String
  pronunciation String?
  meaning     String?
  example     String?
  note        String?
  sortOrder   Int

  @@index([studyPackId, sortOrder])
}

model TournamentTeam {
  id                   String                @id @default(cuid())
  tournamentId         String
  tournament            Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamName             String
  schoolName           String
  className            String?
  managerUserId        String
  managerName          String
  schoolLocation       String?
  rosterJson           Json
  substitutesJson      Json
  color                String                @default("blue")
  registrationStatus   TournamentTeamStatus  @default(PENDING)
  checkedIn            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([tournamentId, registrationStatus])
  @@index([managerUserId])
}

model TournamentMatch {
  id                    String                 @id @default(cuid())
  tournamentId          String
  tournament             Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber           Int
  roundLabel            String
  bracketPosition       Int
  teamAId               String?
  teamBId               String?
  scheduledAt           DateTime
  status                TournamentMatchStatus @default(SCHEDULED)
  checkedInTeamIdsJson  Json                  @default("[]")
  gameSessionId         String?                @unique
  gameSession            GameSession?          @relation(fields: [gameSessionId], references: [id], onDelete: SetNull)
  sessionCode           String?
  settingsSnapshotJson  Json?
  settingsLockedAt      DateTime?
  resultJson            Json?
  winnerTeamId          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([tournamentId, roundNumber, bracketPosition])
  @@index([tournamentId, scheduledAt])
  @@index([sessionCode])
}

model TournamentAuditEvent {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  actorUserId  String
  actorName    String
  action       String
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([tournamentId, createdAt])
}
