DATABASE_URL="postgresql://quizstrike:quizstrike@localhost:5432/quizstrike?schema=public"
JWT_SECRET="replace-me-with-a-long-random-string"
PORT=4000
# Optional local/test override. Production builds use window.location.origin
# and reach the backend through the same-origin Cloudflare routes.
VITE_API_URL="http://localhost:4000"
VITE_API_FALLBACK_URL=""
CLIENT_ORIGIN="http://localhost:5173"
TRUST_PROXY="false"
NETWORK_DEBUG="false"
NETWORK_REPORT_INTERVAL_MS="60000"
VITE_NETWORK_DEBUG="false"
RUNTIME_STORE="in-memory"
INSTANCE_ID=""
ROOM_LEASE_MS="15000"
ROOM_LEASE_RENEW_MS="5000"
SHUTDOWN_TIMEOUT_MS="10000"
VITE_APP_VERSION="0.1.0"

# Speaking Practice provider mode. Keep mock mode for local development/tests;
# production must configure both server-side providers below.
SPEAKING_MOCK_MODE="true"
# Optional bounded classroom session lifetime in seconds (default: 28800 / 8 hours).
SPEAKING_SESSION_LIFETIME_SECONDS="28800"
# SPEAKING_AI_PROVIDER="openai"
# SPEAKING_TRANSCRIPTION_PROVIDER="openai"
# SPEAKING_OPENAI_API_KEY="replace-with-a-server-only-key"
# SPEAKING_OPENAI_MODEL="gpt-4o-mini"
# SPEAKING_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
