{
  "name": "@quizstrike/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-join-css.mjs && tsc && vite build",
    "analyze": "node scripts/check-join-css.mjs && vite build --mode analyze",
    "sync:join-css": "node scripts/check-join-css.mjs --write",
    "test": "node ../../scripts/run-tests.mjs src",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@quizstrike/shared": "0.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "lucide-react": "^0.525.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.178.1",
    "postcss": "^8.5.25",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
